{
  "name": "visioai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch server/server.js",
    "dev:client": "vite --host 127.0.0.1",
